pkgver() {
  cd gtk
  git describe --tags | sed 's/[^-]*-g/r&/;s/-/+/g'
}

prepare() {
  cd gtk

  # Allow -fcf-protection to work
  # https://gitlab.gnome.org/GNOME/gtk/-/issues/6153
  git apply -3 ../0001-HACK-Don-t-use-objcopy-for-resource-embedding.patch

  mkdir ../hooks
  sed -e "s|%%PACMAN_ROOT%%|${pacman_root}|g" \
      -e "s|%%PACMAN_ROOT_REL%%|${pacman_root#/}|g" \
      ../gtk-update-icon-cache.hook > ../hooks/gtk-update-icon-cache.hook

  sed -e "s|%%PACMAN_ROOT%%|${pacman_root}|g" \
      -e "s|%%PACMAN_ROOT_REL%%|${pacman_root#/}|g" \
      ../gtk4-querymodules.hook > ../hooks/gtk4-querymodules.hook
}

build() {
  local meson_options=(
    -D broadway-backend=true
    -D documentation=true
    -D man-pages=true
    -D tracker=enabled
  )

  CFLAGS+=" -DG_DISABLE_CAST_CHECKS"
  arch-meson gtk build "${meson_options[@]}"
  meson compile -C build
}

check() (
  meson test -C build --print-errorlogs
)

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p "$(dirname "$f")" || :
  done
}

package_gtk4() {
  depends+=(gtk-update-icon-cache)
  optdepends=('evince: Default print preview command')
  provides=(libgtk-4.dylib)

  meson install -C build --destdir "$pkgdir"

  install -Dm644 /dev/stdin "$pkgdir/${pacman_root}/usr/share/gtk-4.0/settings.ini" <<END
[Settings]
gtk-icon-theme-name = Adwaita
gtk-theme-name = Adwaita
gtk-font-name = Cantarell 11
END

  install -Dt "$pkgdir/${pacman_root}/usr/share/libalpm/hooks" -m644 hooks/gtk4-querymodules.hook
  install -D gtk4-querymodules.script "$pkgdir/${pacman_root}/usr/share/libalpm/scripts/gtk4-querymodules"

  cd "$pkgdir"

  _pick demo ${pacman_root#/}/usr/bin/gtk4-{demo,demo-application,icon-browser,node-editor,print-editor,widget-factory}
  _pick demo ${pacman_root#/}/usr/share/applications/org.gtk.{Demo4,IconBrowser4,PrintEditor4,WidgetFactory4,gtk4.NodeEditor}.desktop
  _pick demo ${pacman_root#/}/usr/share/glib-2.0/schemas/org.gtk.Demo4.gschema.xml
  _pick demo ${pacman_root#/}/usr/share/icons/hicolor/*/apps/org.gtk.{Demo4,IconBrowser4,PrintEditor4,WidgetFactory4,gtk4.NodeEditor}[-.]*
  _pick demo ${pacman_root#/}/usr/share/man/man1/gtk4-{demo,demo-application,icon-browser,node-editor,widget-factory}.1
  _pick demo ${pacman_root#/}/usr/share/metainfo/org.gtk.{Demo4,IconBrowser4,PrintEditor4,WidgetFactory4,gtk4.NodeEditor}.appdata.xml

  _pick docs ${pacman_root#/}/usr/share/doc

  # Built by GTK 4, shared with GTK 3
  _pick guic ${pacman_root#/}/usr/bin/gtk4-update-icon-cache
  _pick guic ${pacman_root#/}/usr/share/man/man1/gtk4-update-icon-cache.1


}

package_gtk4-demos() {
  pkgdesc+=" (demo applications)"
  depends=(gtk4)
  mv demo/* "$pkgdir"
}

package_gtk4-docs() {
  pkgdesc+=" (documentation)"
  depends=()
  mv docs/* "$pkgdir"
}

package_gtk-update-icon-cache() {
  pkgdesc="GTK icon cache updater"
  depends=(gdk-pixbuf2 librsvg hicolor-icon-theme)

  mv guic/* "$pkgdir"
  ln -s gtk4-update-icon-cache "$pkgdir/${pacman_root}/usr/bin/gtk-update-icon-cache"
  ln -s gtk4-update-icon-cache.1 "$pkgdir/${pacman_root}/usr/share/man/man1/gtk-update-icon-cache.1"

  install -Dt "$pkgdir/${pacman_root}/usr/share/libalpm/hooks" -m644 hooks/gtk-update-icon-cache.hook
  install -D gtk-update-icon-cache.script "$pkgdir/${pacman_root}/usr/share/libalpm/scripts/gtk-update-icon-cache"
}

