# Maintainer: Laurent Carlier <lordheavym@gmail.com>

pkgname=vulkan-icd-loader
pkgver=1.3.285
pkgrel=1
pkgrel+=".3"
arch=('x86_64' 'arm64')
pkgdesc="Vulkan Installable Client Driver (ICD) Loader"
url="https://www.khronos.org/vulkan/"
license=('Apache-2.0')
makedepends=('cmake' 'python-lxml' 'vulkan-headers')
depends=(glibc)
provides=('libvulkan.dylib')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/KhronosGroup/Vulkan-Loader/archive/v${pkgver}.tar.gz")
sha256sums=('3622796919d1b06b27499670502f9888d62a4a2ce3fbf3552365cc8b4301db28')

build() {
  cd "${srcdir}"/Vulkan-Loader*

  sed -i -e 's/FRAMEWORK DESTINATION loader/FRAMEWORK DESTINATION lib/g' loader/CMakeLists.txt

  rm -rf build ; mkdir build ; cd build
  cmake -DCMAKE_INSTALL_PREFIX=${pacman_root}/usr \
    -DVULKAN_HEADERS_INSTALL_DIR=${pacman_root}/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DCMAKE_INSTALL_DATADIR=/share \
    -DCMAKE_SKIP_RPATH=True \
    -DBUILD_TESTS=Off \
    -DCMAKE_BUILD_TYPE=Release \
    ..
  make
}

package() {
  cd "${srcdir}"/Vulkan-Loader*/build
  
  make DESTDIR="${pkgdir}" install
  
  install -dm755 "${pkgdir}"/${pacman_root}/usr/share/licenses/${pkgname}
  install -m644 ../LICENSE.txt "${pkgdir}"/${pacman_root}/usr/share/licenses/${pkgname}/
}
