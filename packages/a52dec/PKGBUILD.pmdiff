--- PKGBUILD
+++ PKGBUILD
@@ -9,0 +10 @@
+pkgrel+=".1"
@@ -11 +12 @@
-arch=(x86_64)
+arch=(x86_64 arm64)
@@ -26,4 +27,4 @@
-  ./configure \
-    --prefix=/usr \
-    --sysconfdir=/etc \
-    --localstatedir=/var \
+  CFLAGS="$CFLAGS -std=gnu89" ./configure \
+    --prefix=${pacman_root}/usr \
+    --sysconfdir=${pacman_root}/etc \
+    --localstatedir=${pacman_root}/var \
@@ -37 +38 @@
-  install -Dm644 -t "$pkgdir/usr/include/a52dec/" liba52/a52_internal.h
+  install -Dm644 -t "$pkgdir/${pacman_root}/usr/include/a52dec/" liba52/a52_internal.h
