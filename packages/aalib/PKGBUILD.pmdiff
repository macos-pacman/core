--- PKGBUILD
+++ PKGBUILD
@@ -7,0 +8 @@
+pkgrel+=".1"
@@ -9 +10 @@
-arch=(x86_64)
+arch=(x86_64 arm64)
@@ -14,2 +14,0 @@
-  gpm
-  libx11
@@ -18,4 +16,0 @@
-)
-optdepends=(
-  'xorg-fonts-misc: x11 driver'
-  'xorg-mkfontscale: x11 driver'
@@ -85,0 +81,2 @@
+  sed -i 's/#include <malloc.h>/#include <stdlib.h>/g' src/*.c
+
@@ -92,4 +89,5 @@
-    --prefix=/usr \
-    --sysconfdir=/etc \
-    --localstatedir=/var \
-    --with-curses-driver
+    --prefix=${pacman_root}/usr \
+    --sysconfdir=${pacman_root}/etc \
+    --localstatedir=${pacman_root}/var \
+    --with-curses-driver \
+    --without-x
