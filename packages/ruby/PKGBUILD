package_ruby() {
  pkgdesc='An object-oriented language for quick and easy programming'
  depends=(gdbm openssl libffi libyaml libxcrypt gmp zlib rubygems ruby-stdlib ruby-bundledgems)
  optdepends=(
      'ruby-docs: Ruby documentation'
      'tk: for Ruby/TK'
  )

  cd ruby-${pkgver}

  make DESTDIR="${pkgdir}" install-nodoc

  install -D -m644 COPYING "${pkgdir}/${pacman_root}/usr/share/licenses/ruby/LICENSE"
  install -D -m644 BSDL "${pkgdir}/${pacman_root}/usr/share/licenses/ruby/BSDL"

  rubyver=${pkgver:0:3}.0

  # remove rubygems as it shipped as a separate package
  rm -r "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/{rubygems,rubygems.rb}
  rm "${pkgdir}"/${pacman_root}/usr/bin/gem

  # remove bundler as it shipped as a separate package
  rm "${pkgdir}"/${pacman_root}/usr/bin/{bundle,bundler}

  # remove bundled rdoc gem
  rm "${pkgdir}"/${pacman_root}/usr/bin/{rdoc,ri}
  rm "${pkgdir}"/${pacman_root}/usr/share/man/man1/ri.1

  # remove irb as it is a separate package now
  rm "${pkgdir}"/${pacman_root}/usr/bin/irb
  rm "${pkgdir}"/${pacman_root}/usr/share/man/man1/irb.1

  # remove other binaries that are shipped as separate packages
  rm "${pkgdir}"/${pacman_root}/usr/bin/{rake,rbs,typeprof,erb,racc}
  rm "${pkgdir}"/${pacman_root}/usr/share/man/man1/erb.1

  # remove all bundled gems to avoid conflicts with ruby-* Arch packages
  rm -r "${pkgdir}"/${pacman_root}/usr/lib/ruby/gems/${rubyver}/gems/*
  rm "${pkgdir}"/${pacman_root}/usr/lib/ruby/gems/${rubyver}/specifications/*.gemspec
  rm "${pkgdir}"/${pacman_root}/usr/lib/ruby/gems/${rubyver}/cache/*.gem

  local ruby_lib_arch="$(uname -m)-darwin$(uname -r | cut -d. -f1)"

  for stdlib_gem in "${stdlib_gems[@]}"; do
    rm -rfv \
      "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/${stdlib_gem#ruby-} \
      "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/${stdlib_gem#ruby-}.rb \
      "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/${ruby_lib_arch}/${stdlib_gem#ruby-}.bundle \
      "${pkgdir}"/${pacman_root}/usr/lib/ruby/gems/${rubyver}/specifications/default/${stdlib_gem#ruby-}-*.gemspec
  done

  rm -rv \
    "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/io/console \
    "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/net/http \
    "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/net/http.rb \
    "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/net/https.rb \
    "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/${ruby_lib_arch}/cgi \
    "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/${ruby_lib_arch}/date_core.bundle \
    "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/${ruby_lib_arch}/digest \
    "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/${ruby_lib_arch}/io/console.bundle \
    "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/${ruby_lib_arch}/io/nonblock.bundle \
    "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/${ruby_lib_arch}/io/wait.bundle \
    "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/${ruby_lib_arch}/json \
    "${pkgdir}"/${pacman_root}/usr/lib/ruby/${rubyver}/${ruby_lib_arch}/racc
}


package_ruby-docs() {
  pkgdesc='Documentation files for ruby'

  cd ruby-${pkgver}

  make DESTDIR="${pkgdir}" install-doc install-capi

  install -D -m644 COPYING "${pkgdir}/${pacman_root}/usr/share/licenses/ruby-docs/LICENSE"
  install -D -m644 BSDL "${pkgdir}/${pacman_root}/usr/share/licenses/ruby-docs/BSDL"
}


package_ruby-stdlib() {
  # upstream list of gems contained in stdlib ( https://github.com/ruby/ruby/tree/master/{ext,lib} )
  pkgdesc='A vast collection of classes and modules that you can require in your code for additional features'
  depends+=("${stdlib_gems[@]}")
}

package_ruby-bundledgems() {
  # upstream list of bundled gems ( https://github.com/ruby/ruby/blob/master/gems/bundled_gems )
  pkgdesc='Ruby Gems (third-party libraries) that are installed by default when Ruby is installed'
  depends=(
    ruby-minitest
    ruby-power_assert
    ruby-rake
    ruby-test-unit
    ruby-rexml
    ruby-rss
    ruby-net-ftp
    ruby-net-imap
    ruby-net-pop
    ruby-net-smtp
    ruby-matrix
    ruby-prime
    ruby-rbs
    ruby-typeprof
    ruby-debug
    ruby-racc
  )
}

